{
  "name": "streamio-desktop",
  "productName": "Streamio",
  "version": "0.2.0",
  "description": "Windows media player: IPTV/M3U8 live TV + VOD, mpv-powered playback",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:wait-and-launch\"",
    "wait-and-launch": "wait-on http://localhost:5173 && npm run dev:electron",
    "build:renderer": "vite build",
    "build": "npm run build:renderer",
    "start": "cross-env NODE_ENV=production electron .",
    "dist": "npm run build:renderer && electron-builder --win"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "iptv-playlist-parser": "^0.13.0",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.dragonate88.streamio",
    "productName": "Streamio",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "artifactName": "Streamio-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
